# Copy to .env.local (ignored by git) or set in your hosting dashboard.
# Every value is optional: when one is empty, that feature stays off.

# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ
VITE_GA_ID=

# Plausible Analytics site domain, e.g. thiqauni.com
VITE_PLAUSIBLE_DOMAIN=

# Google Apps Script web app URL that saves leads to a Google Sheet
# (setup: docs/google-sheet-leads.md)
VITE_LEADS_ENDPOINT=
